## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ClassIsland plugin package output
cipx/

# Visual Studio cache/options
.vs/
*.cache

# Rider
.idea/

# NuGet
*.nupkg
packages/
project.lock.json
*.nuget.props
*.nuget.targets
.nuget-cache/
